# ---- Database ----
# Local dev (zero setup): SQLite
DATABASE_URL=sqlite:///./queryhub.db
READONLY_DATABASE_URL=sqlite:///./queryhub.db
# Supabase / Postgres (psycopg v3 driver ke liye "+psycopg" zaroori hai):
# DATABASE_URL=postgresql+psycopg://queryhub_app:***@db.xxxx.supabase.co:5432/postgres
# READONLY_DATABASE_URL=postgresql+psycopg://queryhub_ro:***@db.xxxx.supabase.co:5432/postgres
AUTO_MIGRATE=true

# ---- Cache / jobs ----
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:***@xxxx.upstash.io:6379

# ---- LLM (Groq -> Gemini -> Ollama fallback) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TEMPERATURE=0

# ---- RAG ----
CHROMA_PATH=./chroma
SCHEMA_RAG=auto

# ---- Auth ----
JWT_SECRET=change-me
AUTH_DISABLED=false
# Supabase Auth (optional) — set karo to Supabase login tokens accept honge
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ---- Q-TRACE+ ----
QTRACE_MAX_LLM_CALLS=15
QTRACE_MAX_QUERIES=40
QTRACE_EXPLAINED_TARGET=0.80
QTRACE_FDR_Q=0.10
